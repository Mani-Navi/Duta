        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName Tahoma\nskinparam componentStyle rectangle\nskinparam shadowing false\n\nactor \&quot;کاربر واقعی\\n(Browser / Mobile)\&quot; as User\nactor \&quot;ربات‌های سئو و شبکه اجتماعی\\n(Googlebot / TelegramBot)\&quot; as Bot\n\ncloud \&quot;منابع بیرونی\&quot; {\n    component \&quot;فیدهای RSS خبرگزاری‌ها\&quot; as RSS\n    component \&quot;سایت TGJU\\n(قیمت دلار و طلا)\&quot; as TGJU\n}\n\nnode \&quot;سرور ابری پارس‌پک (https://duta.ir)\&quot; {\n\n    package \&quot;Nginx Reverse Proxy (Port 80/443 + HTTP/2 + Gzip)\&quot; {\n        component \&quot;Canonical Redirect (301)\\nwww &amp; IP -&gt; duta.ir\&quot; as Redirect\n        component \&quot;Bot Detector ($is_bot)\\n&amp; /robots.txt + /sitemap.xml\&quot; as NginxRouter\n        component \&quot;Static Files (React 19 SPA)\\n/usr/share/nginx/html\&quot; as SPA\n    }\n\n    node \&quot;Docker Container: Prerender\&quot; {\n        component \&quot;duta-prerender:4000\\n(Dynamic OG &amp; Meta Renderer)\&quot; as Prerender\n    }\n\n    node \&quot;Docker Container: nitt-backend:8080 (Java 21 / Spring Boot 3.3)\&quot; {\n        component \&quot;RateLimitInterceptor\\n(120 req/min via X-Real-IP)\&quot; as RateLimit\n        component \&quot;REST Controllers\\n(Article, Cluster, Price, SEO)\&quot; as Controllers\n        database \&quot;Caffeine Cache\\n(In-Memory, 10m TTL)\&quot; as Cache\n        component \&quot;Core Intelligence\\n(Classifier, Jaccard Clustering,\\nBayesian Scoring, SlugService)\&quot; as Services\n        component \&quot;Background Schedulers\\n(5 Async RSS Threads + Price Job)\&quot; as Schedulers\n    }\n\n    database \&quot;PostgreSQL Database\\n(articles, clusters, sources, categories)\&quot; as DB\n}\n\nUser --&gt; Redirect : HTTPS\nBot --&gt; Redirect : HTTPS\nRedirect --&gt; NginxRouter\n\nNginxRouter --&gt; SPA : Human ($is_bot = 0)\nNginxRouter --&gt; Prerender : Bot on /article/* ($is_bot = 1)\nPrerender .&gt; SPA : Fallback on 502/504\nPrerender --&gt; Controllers : GET /api/articles/seo/{slug}\n\nSPA --&gt; RateLimit : /api/*\nNginxRouter --&gt; Controllers : /sitemap.xml\nRateLimit --&gt; Controllers\n\nControllers &lt;--&gt; Cache : Read / CacheEvict\nControllers --&gt; Services\nServices &lt;--&gt; DB\n\nSchedulers --&gt; RSS : Every 5 min\nSchedulers --&gt; TGJU : Every 5 min\nSchedulers --&gt; Services\nSchedulers .&gt; Cache : Evict on new articles\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NlxUj2sNAYKc58V4VYeo-322">
