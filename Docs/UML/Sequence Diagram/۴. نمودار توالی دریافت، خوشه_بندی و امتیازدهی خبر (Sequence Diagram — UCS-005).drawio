        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam defaultFontName Tahoma\nskinparam shadowing false\nskinparam responseMessageBelowArrow true\n\nparticipant \&quot;Spring Scheduler\&quot; as S\nparticipant \&quot;RssFetcherService\\n(5 Parallel Threads)\&quot; as F\nparticipant \&quot;CategoryClassifier\&quot; as C\nparticipant \&quot;SlugService\&quot; as SL\nparticipant \&quot;ClusteringService\\n(Jaccard)\&quot; as CL\nparticipant \&quot;ScoringService\\n(Bayesian)\&quot; as SC\ndatabase \&quot;PostgreSQL\&quot; as DB\ndatabase \&quot;Caffeine Cache\&quot; as CA\n\nS -&gt; F : اجرای سیکل ۵ دقیقه‌ای (fetchAllSources)\nF -&gt; DB : واکشی لیست منابع فعال RSS\n\ngroup اجرای موازی روی ۵ ترد (rssTaskExecutor)\n    F -&gt; F : دریافت XML فید و استخراج تیتر + خلاصه تمیز (Jsoup)\n    F -&gt; DB : بررسی عدم تکرار لینک (existsByUrl)\n\n    alt خبر جدید است (Not Duplicate)\n        F -&gt; C : classify(title, source) با تطابق مرز کلمه\n        C --&gt; F : دسته‌بندی دقیق خبر\n        F -&gt; SL : generateSlug(title) [Synchronized]\n        SL --&gt; F : اسلاگ فارسی یکتا\n        F -&gt; DB : ذخیره اولیه رکورد Article\n\n        F -&gt; CL : clusterArticle(article) [Synchronized]\n        CL -&gt; DB : دریافت کلسترهای ۶ ساعت اخیر (findByCreatedAtAfter)\n        CL -&gt; CL : نرمال‌سازی توکن‌ها و محاسبه شباهت جاکارد\n\n        alt شباهت جاکارد &gt;= 25% با کلستر موجود\n            CL -&gt; DB : اتصال خبر به کلستر و شمارش منابع یکتا (DISTINCT source_id)\n            CL -&gt; SC : calculateClusterScore(cluster)\n            SC --&gt; CL : امتیاز نهایی (Credibility² + Verification Boost)\n            CL -&gt; DB : بروزرسانی امتیاز و تیتر نماینده کلستر\n        else عدم یافتن کلستر مشابه\n            CL -&gt; DB : ایجاد ArticleCluster جدید\n        end\n    end\nend\n\nalt حداقل ۱ خبر جدید ذخیره شده باشد\n    F -&gt; CA : evictArticlesCache() پاکسازی کش صفحه اول\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NlxUj2sNAYKc58V4VYeo-361">
